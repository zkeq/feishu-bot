# OpenAI 主 API 配置（所有 Bot 共享）
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini


# OpenAI 备用 API 配置（可选，用于故障转移）
OPENAI_API_KEY_BACKUP=your-backup-api-key-here
OPENAI_BASE_URL_BACKUP=https://backup-api.example.com/v1
OPENAI_MODEL_BACKUP=gpt-4o-mini

# API 重试配置
API_MAX_RETRIES=3  # 每个源的最大重试次数（默认3次）
API_RETRY_DELAY=2  # 重试基础延迟，单位秒（使用指数退避，默认2秒）

# 注意：飞书应用配置（LARK_APP_ID/LARK_APP_SECRET）
# 现在在每个 Bot 的 config.yaml 中独立配置
